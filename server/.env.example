# LLM: ollama | huggingface | groq | openrouter | openai | none
# Defaults to huggingface when HF_TOKEN is set, otherwise ollama on localhost.
SIBR_LLM_PROVIDER=ollama
# SIBR_LLM_MODEL=llama3.2:3b
# SIBR_LLM_BASE_URL=http://localhost:11434/v1
# SIBR_LLM_API_KEY=
# HF_TOKEN=hf_...

# Laya: local (in-process, needs `pip install laya`) | http (a laya-serve URL)
SIBR_LAYA_MODE=local
SIBR_LAYA_MODEL=english
# SIBR_LAYA_URL=http://localhost:8000
# SIBR_LAYA_API_KEY=
# Cells whose Laya confidence falls below this are marked for a human check.
SIBR_LAYA_MIN_CONFIDENCE=0.5

SIBR_CORS_ORIGINS=https://munazzar.github.io,http://localhost:8080
