# LLM: ollama (default, free, local) | huggingface | groq | openrouter | openai | none
SIBR_LLM_PROVIDER=ollama
# SIBR_LLM_MODEL=llama3.2:3b
# SIBR_LLM_BASE_URL=http://localhost:11434/v1
# SIBR_LLM_API_KEY=
# HF_TOKEN=hf_...

# Laya: local (in-process, needs `pip install laya`) | http (a laya-serve URL)
SIBR_LAYA_MODE=local
SIBR_LAYA_MODEL=english
# Fine-tuned checkpoint from `python -m training.finetune`; replaces the stock model when set.
# SIBR_LAYA_CHECKPOINT=training/checkpoints/sibr-laya
# SIBR_LAYA_URL=http://localhost:8000
# SIBR_LAYA_API_KEY=
# Cells whose Laya confidence falls below this are marked for a human check.
SIBR_LAYA_MIN_CONFIDENCE=0.5

# Free web evidence via DuckDuckGo (no key). Set to off to skip.
SIBR_EVIDENCE=ddg
SIBR_EVIDENCE_RESULTS=3

# Access key for /evaluate (sent as X-Sibr-Key). scripts\setup.ps1 generates one.
# SIBR_API_KEY=
# The service also serves the site on the same port; set to 0 to disable.
SIBR_SERVE_SITE=1

SIBR_CORS_ORIGINS=https://munazzar.github.io,http://localhost:8080
